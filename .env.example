POSTGRES_USER=studio
COMPOSE_PARALLEL_LIMIT=4
POSTGRES_PASSWORD=studio
POSTGRES_DB=studio
DATABASE_URL=postgresql+asyncpg://studio:studio@postgres:5432/studio
REDIS_URL=redis://redis:6379/0
API_URL=http://api:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
EMBED_URL=http://embed:8001
WEB_ORIGIN=http://localhost:3000
STORAGE_BACKEND=local
# STORAGE_BACKEND=memory is an ephemeral development/test alternative.
STORAGE_PATH=/app/storage
# Level 0 uses fake; Gemma 2 is implemented in Level 2.
EMBED_BACKEND=fake
EMBED_DIM=768
EMBED_BATCH_SIZE=32
EMBED_CONCURRENCY=2
LLM_PROVIDER=openrouter
DEFAULT_CHAT_MODEL=
DEFAULT_CHEAP_MODEL=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_CONCURRENCY=4
UPLOAD_MAX_MB=50
