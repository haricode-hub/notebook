POSTGRES_USER=studio
COMPOSE_PARALLEL_LIMIT=4
POSTGRES_PASSWORD=studio
POSTGRES_DB=studio
DATABASE_URL=postgresql+asyncpg://studio:studio@postgres:5432/studio
REDIS_URL=redis://redis:6379/0
API_URL=http://api:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
EMBED_URL=http://embed:8001
WEB_ORIGIN=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
# Compose derives the internal JWKS URL from the web service name.
JWKS_URL=http://web:3000/api/auth/jwks
JWT_ISSUER=http://localhost:3000
JWT_AUDIENCE=opennotebook-api
# Generate with `openssl rand -base64 32` before deployment.
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Generate with `uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`.
SETTINGS_ENCRYPTION_KEY=
STORAGE_BACKEND=local
# STORAGE_BACKEND=memory is an ephemeral development/test alternative.
STORAGE_PATH=/app/storage
# Use fake only for deterministic tests and fast local UI checks.
EMBED_BACKEND=gemma2
EMBED_DIM=768
EMBED_BATCH_SIZE=8
EMBED_CONCURRENCY=2
EMBED_CACHE_ENTRIES=512
# Multimodal model towers increase embed-service memory; keep disabled by default.
MULTIMODAL_ENABLED=false
MULTIMODAL_IMAGE_ENABLED=true
MULTIMODAL_AUDIO_ENABLED=false
MULTIMODAL_IMAGE_MAX_SOFT_TOKENS=70
LLM_PROVIDER=openrouter
DEFAULT_CHAT_MODEL=google/gemini-3.1-flash-lite
DEFAULT_CHEAP_MODEL=google/gemini-3.1-flash-lite
FALLBACK_MODEL=
ARTIFACT_MAP_MAX_BYTES=10000
OPENROUTER_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
TTS_PROVIDER=kokoro
TTS_CONCURRENCY=1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434
LLM_CONCURRENCY=4
JOB_MAX_TRIES=3
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
ORPHAN_FILE_GRACE_HOURS=24
CHAT_CONTEXT_TOKENS=8192
CHAT_MAX_HISTORY=6
CHAT_RATE_LIMIT_PER_MINUTE=30
CHAT_RERANK=false
SUMMARY_MAP_MAX_BYTES=6000
UPLOAD_MAX_MB=50
SOURCE_QUOTA_PER_USER=250
CHAT_TOKENS_PER_DAY=100000
